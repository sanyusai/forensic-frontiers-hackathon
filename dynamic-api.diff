+@app.post("/api/messages/{message_id}/attachments/{part_id}/dynamic-analysis")
+def submit_dynamic_analysis(message_id: str, part_id: str, force: bool = False):
+    """Explicitly submit an attachment to a separately configured CAPE sandbox."""
+    if not re.fullmatch(r"[A-Za-z0-9_-]+", message_id):
+        raise HTTPException(status_code=400, detail="Invalid Gmail message ID")
+    if not re.fullmatch(r"[A-Za-z0-9_.-]+", part_id) or len(part_id) > 100:
+        raise HTTPException(status_code=400, detail="Invalid Gmail attachment part ID")
+    if not CAPE_CLIENT.enabled:
+        raise HTTPException(status_code=503, detail=CAPE_CLIENT.configuration_status()["message"])
+
+    existing = load_dynamic_scan(message_id, part_id)
+    if existing is not None and not force and existing["status"] != "error":
+        return existing
+
+    try:
+        raw_data, filename, _ = fetch_gmail_attachment(message_id, part_id)
+        task_id = CAPE_CLIENT.submit(raw_data, filename=filename)
+        return save_dynamic_scan(message_id, part_id, task_id, "queued")
+    except HTTPException:
+        raise
+    except DynamicAnalysisError as error:
+        raise HTTPException(status_code=502, detail=str(error)) from error
+    except Exception as error:
+        raise HTTPException(status_code=500, detail="Unable to submit the attachment for dynamic analysis") from error
+
+
+@app.get("/api/messages/{message_id}/attachments/{part_id}/dynamic-analysis")
+def get_dynamic_analysis(message_id: str, part_id: str):
+    """Poll CAPE and return a normalized behavior report once the task completes."""
+    if not re.fullmatch(r"[A-Za-z0-9_-]+", message_id):
+        raise HTTPException(status_code=400, detail="Invalid Gmail message ID")
+    if not re.fullmatch(r"[A-Za-z0-9_.-]+", part_id) or len(part_id) > 100:
+        raise HTTPException(status_code=400, detail="Invalid Gmail attachment part ID")
+
+    saved = load_dynamic_scan(message_id, part_id)
+    if saved is None:
+        raise HTTPException(status_code=404, detail="No dynamic-analysis task exists for this attachment")
+    if saved["status"] == "complete" and saved["analysis"]:
+        result = dict(saved["analysis"])
+        result.update({"message_id": message_id, "part_id": part_id, "cached": True})
+        return result
+    if saved["status"] == "error":
+        return saved
+
+    try:
+        status = CAPE_CLIENT.task_status(saved["task_id"])
+        if status == "error":
+            return save_dynamic_scan(
+                message_id,
+                part_id,
+                saved["task_id"],
+                "error",
+                submitted_at=saved["submitted_at"],
+                error="The sandbox task failed before a report was produced.",
+            )
+        if status != "complete":
+            return save_dynamic_scan(
+                message_id,
+                part_id,
+                saved["task_id"],
+                status,
+                submitted_at=saved["submitted_at"],
+            )
+
+        report = CAPE_CLIENT.report(saved["task_id"])
+        report.update({"message_id": message_id, "part_id": part_id, "cached": False})
+        save_dynamic_scan(
+            message_id,
+            part_id,
+            saved["task_id"],
+            "complete",
+            submitted_at=saved["submitted_at"],
+            analysis=report,
+        )
+        return report
+    except DynamicAnalysisError as error:
+        return save_dynamic_scan(
+            message_id,
+            part_id,
+            saved["task_id"],
+            "error",
+            submitted_at=saved["submitted_at"],
+            error=str(error),
+        )
