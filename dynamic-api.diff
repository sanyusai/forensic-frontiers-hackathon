+def fetch_gmail_attachment(message_id: str, part_id: str) -> tuple[bytes, str, str]:
+    """Retrieve a selected MIME part after the caller has validated both identifiers."""
+    gmail = get_gmail_service()
+    message = gmail.users().messages().get(
+        userId="me", id=message_id, format="full"
+    ).execute()
+    selected_part = next(
+        (
+            part for part in walk_parts(message.get("payload", {}))
+            if str(part.get("partId", "")) == part_id and part.get("filename")
+        ),
+        None,
+    )
+    if selected_part is None:
+        raise HTTPException(status_code=404, detail="Attachment part was not found in this message")
+
+    body = selected_part.get("body", {}) or {}
+    reported_size = int(body.get("size", 0) or 0)
+    if reported_size > MAX_ATTACHMENT_BYTES:
+        raise HTTPException(
+            status_code=413,
+            detail=f"Attachment exceeds the {MAX_ATTACHMENT_BYTES // (1024 * 1024)} MB analysis limit",
+        )
+
+    encoded_data = body.get("data")
+    attachment_id = body.get("attachmentId")
+    if not encoded_data and attachment_id:
+        attachment_body = gmail.users().messages().attachments().get(
+            userId="me", messageId=message_id, id=attachment_id
+        ).execute()
+        encoded_data = attachment_body.get("data")
+    if not encoded_data:
+        raise HTTPException(status_code=422, detail="Gmail did not return attachment content")
+
+    padded_data = encoded_data + "=" * (-len(encoded_data) % 4)
+    raw_data = base64.urlsafe_b64decode(padded_data)
+    if len(raw_data) > MAX_ATTACHMENT_BYTES:
+        raise HTTPException(
+            status_code=413,
+            detail=f"Attachment exceeds the {MAX_ATTACHMENT_BYTES // (1024 * 1024)} MB analysis limit",
+        )
+    return (
+        raw_data,
+        selected_part.get("filename") or "unnamed-attachment",
+        selected_part.get("mimeType") or "application/octet-stream",
+    )
+
